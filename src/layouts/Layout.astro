---
import "../styles/global.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased">
    <slot />

    <script type="module">
      import Typebot from "https://cdn.jsdelivr.net/npm/@typebot.io/js@0.3/dist/index.js";

      Typebot.initBubble({
        typebot: "bot-luis-r-cwabbl9", // Tu ID de Typebot
        previewMessage: {
          text: "¡Hola! Soy el agente IA de Luis. ¿Hablamos?",
          autoShowDelay: 3000,
        },
        theme: {
          button: { backgroundColor: "#0F172A" },
        },
      });
    </script>
  </body>
</html>
