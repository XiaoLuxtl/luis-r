---
import contact from "../content/contact.json";
---

<section
  class="mt-16 p-8 bg-white rounded-2xl border border-slate-200 shadow-sm"
>
  <div class="max-w-4xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
      <div class="space-y-4">
        <h2 class="text-3xl font-bold">
          <span data-lang="en">{contact.title}</span>
          <span data-lang="es" class="hidden">{contact.title_es}</span>
        </h2>
        <p class="text-slate-600">
          <span data-lang="en">{contact.description}</span>
          <span data-lang="es" class="hidden">{contact.description_es}</span>
        </p>

        <div class="flex gap-3 mt-4">
          <a
            href={contact.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-secondary text-white hover:opacity-95 transition font-medium"
          >
            <svg
              class="w-5 h-5"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.11 1 2.5 1 4.98 2.12 4.98 3.5zM0 8h5v16H0V8zm7.5 0H12v2.2h.1c.6-1.1 2.1-2.2 4.3-2.2 4.6 0 5.4 3 5.4 6.9V24h-5v-7.6c0-1.8 0-4.1-2.5-4.1-2.5 0-2.9 1.9-2.9 4v7.7h-5V8z" />
            </svg>
            <span data-lang="en">Connect on LinkedIn</span>
            <span data-lang="es" class="hidden">Conectar en LinkedIn</span>
          </a>
        </div>
      </div>

      <div class="rounded-lg overflow-hidden">
        {contact.image ? (
          <img
            src={contact.image}
            alt="Contact"
            class="w-full h-64 object-cover md:h-full rounded-lg"
          />
        ) : (
          <div class="w-full h-64 bg-slate-100 flex items-center justify-center text-slate-400">
            Placeholder
          </div>
        )}
      </div>
    </div>
  </div>
</section>
