---
import Layout from "../layouts/Layout.astro";
import { getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import contact from "../content/contact.json";

const entry = await getEntry("article", "n8n-rag-whatsapp");

if (!entry) {
  return Astro.redirect("/404/");
}

const { Content } = await render(entry);
---

<Layout title={entry.data.title || "WhatsApp RAG Case Study"}>
  <main class="max-w-4xl mx-auto px-6 py-20">
    <article class="space-y-12">
      <!-- Header / Hero Section -->
      <header class="text-center space-y-4 max-w-3xl mx-auto">
        <h1
          class="text-4xl md:text-5xl font-bold tracking-tight text-primary leading-tight"
        >
          {entry.data.title}
        </h1>
        <p class="text-xl text-slate-600">
          {entry.data.description}
        </p>
      </header>

      {
        entry.data.heroImage && (
          <div class="rounded-2xl overflow-hidden shadow-2xl border border-slate-200 aspect-video">
            <Image
              src={entry.data.heroImage}
              alt={entry.data.title || ""}
              class="w-full h-full object-cover"
            />
          </div>
        )
      }

      <!-- Content -->
      <div
        class="prose prose-slate prose-lg max-w-none
                  prose-headings:text-primary prose-headings:font-bold
                  prose-a:text-secondary prose-a:no-underline hover:prose-a:underline
                  prose-img:rounded-xl prose-img:shadow-lg prose-img:border prose-img:border-slate-200"
      >
        <Content />
      </div>

      <!-- Footer CTA -->
      <footer class="pt-16 border-t border-slate-200">
        <div
          class="bg-slate-900 text-white p-8 rounded-2xl flex flex-col md:flex-row items-center justify-between gap-6"
        >
          <div class="space-y-2 text-center md:text-left">
            <h3 class="text-2xl font-semibold">
              Ready to scale your conversational experiences?
            </h3>
            <p class="text-slate-400">
              Let's discuss how my tech stack can drive with the role's success.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href={`mailto:${contact.email}`}
              class="bg-secondary text-white px-8 py-3 rounded-full font-medium hover:bg-primary transition-all shadow-lg hover:shadow-primary/20 text-center"
            >
              Send Message
            </a>
            <a
              href="../"
              class="bg-white/10 text-white border border-white/20 px-8 py-3 rounded-full font-medium hover:bg-white/20 transition-all text-center"
            >
              Back to Home
            </a>
          </div>
        </div>
      </footer>
    </article>
  </main>
</Layout>
