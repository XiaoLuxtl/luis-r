---
import Layout from "../layouts/Layout.astro";
import ContactSection from "../components/ContactSection.astro";
import LanguageToggle from "../components/LanguageToggle.astro";
---

<Layout title="Luis Rendón | AI Automation Engineer">
  <LanguageToggle />

  <main class="max-w-2xl mx-auto px-6 py-20">
    <header class="mb-12">
      <h1 class="text-4xl font-bold tracking-tight mb-2">Luis Rendón</h1>
      <p class="text-lg text-slate-600">
        AI Automation Engineer | n8n Creator
      </p>
    </header>

    <section class="space-y-16">
      <!-- Typebot Integration Section -->
      <div class="space-y-6">
        <div class="flex items-center gap-3">
          <div
            class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center"
          >
            <svg
              class="w-5 h-5 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"
              ></path></svg
            >
          </div>
          <h2 class="text-2xl font-bold text-primary">
            <span data-lang="en">Test my chatbot AI Agent</span>
            <span data-lang="es" class="hidden">Prueba mi agente AI</span>
          </h2>
        </div>

        <div
          class="w-full bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden"
          style="min-height: 600px; height: 80vh;"
        >
          <typebot-standard style="width: 100%; height: 100%;"
          ></typebot-standard>
        </div>

        <p class="text-center text-sm text-slate-400">
          <span data-lang="en">Have technical questions? Ask my bot programmed with n8n.</span>
          <span data-lang="es" class="hidden">¿Preguntas técnicas? Pregúntale a mi bot programado con n8n.</span>
        </p>
      </div>

      <!-- About Me -->
      <div class="space-y-4">
        <h2 class="text-2xl font-bold text-primary">
          <span data-lang="en">About</span>
          <span data-lang="es" class="hidden">Sobre mí</span>
        </h2>
        <p class="text-slate-600 leading-relaxed">
          <span data-lang="en">
            I build production AI agents and automation pipelines with n8n, RAG, and LLMs.
            Self-hosted infrastructure on Oracle Cloud (Docker, ARM64). I also run
            <a href="https://pixelpages.com.mx/" target="_blank" rel="noopener noreferrer" class="text-secondary font-medium hover:underline">PixelPages</a>,
            an AI-powered photo restoration business with real paying clients.
          </span>
          <span data-lang="es" class="hidden">
            Construyo agentes AI en producción y pipelines de automatización con n8n, RAG y LLMs.
            Infraestructura self-hosted en Oracle Cloud (Docker, ARM64). También opero
            <a href="https://pixelpages.com.mx/" target="_blank" rel="noopener noreferrer" class="text-secondary font-medium hover:underline">PixelPages</a>,
            un negocio de restauración fotográfica con IA y clientes reales.
          </span>
        </p>
      </div>

      <!-- Projects -->
      <div class="space-y-10">
        <h2 class="text-2xl font-bold text-primary">
          <span data-lang="en">Projects</span>
          <span data-lang="es" class="hidden">Proyectos</span>
        </h2>

        <!-- n8n Automation -->
        <div class="space-y-4">
          <h3 class="text-lg font-semibold text-slate-800 border-b border-slate-200 pb-2">
            <span data-lang="en">n8n Automation</span>
            <span data-lang="es" class="hidden">Automatización n8n</span>
          </h3>

          <a
            href="https://n8n.io/creators/xiaolux/"
            target="_blank"
            rel="noopener noreferrer"
            class="group block p-5 bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-lg transition-shadow"
          >
            <h4 class="font-bold text-primary group-hover:text-secondary transition-colors">n8n Creator Profile</h4>
            <p class="text-sm text-slate-600 mt-1">
              <span data-lang="en">Published production templates: WhatsApp voice transcription, intent classification with GPT-4o-mini.</span>
              <span data-lang="es" class="hidden">Templates en producción: transcripción de voz WhatsApp, clasificación de intención con GPT-4o-mini.</span>
            </p>
          </a>

          <a
            href="./case-study/"
            class="group block p-5 bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-lg transition-shadow"
          >
            <h4 class="font-bold text-primary group-hover:text-secondary transition-colors">
              <span data-lang="en">Chatbot AI Agent Infrastructure</span>
              <span data-lang="es" class="hidden">Infraestructura de Agente AI Chatbot</span>
            </h4>
            <p class="text-sm text-slate-600 mt-1">
              <span data-lang="en">Custom stack: n8n + Typebot + Docker + Nginx on Oracle Cloud VPS.</span>
              <span data-lang="es" class="hidden">Stack personalizado: n8n + Typebot + Docker + Nginx en VPS Oracle Cloud.</span>
            </p>
          </a>

          <a
            href="./n8n-rag-whatsapp/"
            class="group block p-5 bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-lg transition-shadow"
          >
            <h4 class="font-bold text-primary group-hover:text-secondary transition-colors">
              <span data-lang="en">Multi-Tenant RAG WhatsApp Bot</span>
              <span data-lang="es" class="hidden">Bot RAG WhatsApp Multi-Tenant</span>
            </h4>
            <p class="text-sm text-slate-600 mt-1">
              <span data-lang="en">Self-hosted AI assistant. Semantic search, isolated data per client. $5/mo for 100 clients.</span>
              <span data-lang="es" class="hidden">Asistente AI self-hosted. Búsqueda semántica, datos aislados por cliente. $5/mes para 100 clientes.</span>
            </p>
          </a>
        </div>

        <!-- AI Business -->
        <div class="space-y-4">
          <h3 class="text-lg font-semibold text-slate-800 border-b border-slate-200 pb-2">
            <span data-lang="en">AI Business</span>
            <span data-lang="es" class="hidden">Negocio con IA</span>
          </h3>

          <a
            href="https://pixelpages.com.mx/"
            target="_blank"
            rel="noopener noreferrer"
            class="group block p-5 bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-lg transition-shadow"
          >
            <div class="flex items-center gap-2">
              <h4 class="font-bold text-primary group-hover:text-secondary transition-colors">PixelPages</h4>
              <span class="px-1.5 py-0.5 bg-green-100 text-green-700 text-xs font-medium rounded">PageSpeed 100</span>
            </div>
            <p class="text-sm text-slate-600 mt-1">
              <span data-lang="en">AI photo restoration. LoRA fine-tuning, facial reconstruction, Giclee printing. Real clients, real revenue.</span>
              <span data-lang="es" class="hidden">Restauración fotográfica con IA. Fine-tuning LoRA, reconstrucción facial, impresión Giclee. Clientes reales.</span>
            </p>
          </a>
        </div>

        <!-- Data Engineering -->
        <div class="space-y-4">
          <h3 class="text-lg font-semibold text-slate-800 border-b border-slate-200 pb-2">
            <span data-lang="en">Data Engineering</span>
            <span data-lang="es" class="hidden">Ingeniería de Datos</span>
          </h3>

          <a
            href="https://xiaoluxtl.github.io/tempmap/"
            target="_blank"
            rel="noopener noreferrer"
            class="group block p-5 bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-lg transition-shadow"
          >
            <h4 class="font-bold text-primary group-hover:text-secondary transition-colors">
              <span data-lang="en">Real Estate Analysis Map</span>
              <span data-lang="es" class="hidden">Mapa de Análisis Inmobiliario</span>
            </h4>
            <p class="text-sm text-slate-600 mt-1">
              <span data-lang="en">Daily scraping → ETL → scoring → interactive Voronoi maps. Python, Selenium, OpenAI.</span>
              <span data-lang="es" class="hidden">Scraping diario → ETL → scoring → mapas Voronoi interactivos. Python, Selenium, OpenAI.</span>
            </p>
          </a>
        </div>
      </div>

      <!-- Skills / Tech Stack -->
      <div class="space-y-4">
        <h2 class="text-2xl font-bold text-primary">Stack</h2>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 text-sm font-medium rounded-full bg-[#EA4B71]/10 text-[#EA4B71] border border-[#EA4B71]/20">n8n</span>
          <span class="px-3 py-1 text-sm font-medium rounded-full bg-[#3776AB]/10 text-[#3776AB] border border-[#3776AB]/20">Python</span>
          <span class="px-3 py-1 text-sm font-medium rounded-full bg-[#3178C6]/10 text-[#3178C6] border border-[#3178C6]/20">TypeScript</span>
          <span class="px-3 py-1 text-sm font-medium rounded-full bg-[#2496ED]/10 text-[#2496ED] border border-[#2496ED]/20">Docker</span>
          <span class="px-3 py-1 text-sm font-medium rounded-full bg-[#10A37F]/10 text-[#10A37F] border border-[#10A37F]/20">OpenAI</span>
          <span class="px-3 py-1 text-sm font-medium rounded-full bg-[#F48120]/10 text-[#F48120] border border-[#F48120]/20">RAG</span>
          <span class="px-3 py-1 text-sm font-medium rounded-full bg-slate-500/10 text-slate-600 border border-slate-300">Oracle Cloud</span>
          <span class="px-3 py-1 text-sm font-medium rounded-full bg-[#BC4C00]/10 text-[#BC4C00] border border-[#BC4C00]/20">Astro</span>
        </div>
      </div>
    </section>

    <ContactSection />
  </main>

  <script type="module">
    import Typebot from "https://cdn.jsdelivr.net/npm/@typebot.io/js@0.3/dist/web.js";

    function initBot() {
      if (!document.querySelector("typebot-standard")) return;
      Typebot.initStandard({
        typebot: "bot-luis-r-cwabbl9",
      });
    }

    initBot();
    document.addEventListener("astro:page-load", initBot);
  </script>
</Layout>
